{
  "manifest_version": 3,
  "name": "Sit Listing Marker for TrustedHousesitters (unofficial)",
  "version": "0.1.0",
  "description": "Unofficial: mark TrustedHousesitters sit listings as interested or not interested, and see your marks on every search.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sit Listing Marker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.trustedhousesitters.com/*"],
      "js": [
        "src/lib/listing-id.js",
        "src/lib/store.js",
        "src/lib/format.js",
        "src/content/popover.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
